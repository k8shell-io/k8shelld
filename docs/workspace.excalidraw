      "updated": 1746528285403,
      "link": null,
      "locked": false,
      "text": "The state manager persists the workspace state by storing \nthe upperdir as a new image layer. This allows the workspace \nto resume from its previous state by starting a new instance \nbased on that layer.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The state manager persists the workspace state by storing \nthe upperdir as a new image layer. This allows the workspace \nto resume from its previous state by starting a new instance \nbased on that layer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
